<%# What people said: a course's participants or an area's clients. locals: testimonies, title, section_id %>
<% unless testimonies.nil? || testimonies.empty? %>
  <section id="<%= section_id %>" class="">
    <h2 class="mb-5 text-center common-subtitle"><%= title %></h2>
    <div class="testimonies-container">
      <% testimonies.each do |testimony| %>
        <div class="testimony-container">
          <div class="testimony-info">
            <div class="testimony-info__photo-container">
              <img
                src="<%= testimony.photo_url ? testimony.photo_url : "/app/img/icons/People.svg"%>"
                class="rounded-circle testimony-info__photo"
                loading="lazy"
              >
            </div>
            <div>
              <strong>
                <%= "#{testimony.name} #{testimony.last_name}" %>
              </strong>
              <% unless testimony.context.empty? %>
                <div class="testimony-info__context"><%= testimony.context %></div>
              <% end %>
              <% if testimony.linkedin_url %>
                <div>
                  <a href="<%= testimony.linkedin_url %>">
                    <img class="testimony-linkedin" src="/app/img/icons/Linkedin.svg" loading="lazy">
                  </a>
                </div>
              <% end %>
            </div>
          </div>
          <div class="testimony-message">
            "<%= testimony.message %>"
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
