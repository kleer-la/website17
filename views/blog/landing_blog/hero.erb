<section id="landing-blog-hero" class="mb-5">
    <nav aria-label="Breadcrumb" class="blog-breadcrumb">
      <ol class="breadcrumb">
        <% @breadcrumbs.each do |crumb| %>
          <% if crumb[:path] %>
            <li class="breadcrumb-item"><a href="<%= crumb[:path] %>"><%= crumb[:name] %></a></li>
          <% else %>
            <li class="breadcrumb-item active" aria-current="page"><%= crumb[:name] %></li>
          <% end %>
        <% end %>
      </ol>
    </nav>
    <div class="mt-4 mb-5">
      <div class="landing-blog-hero__title-container">
        <h1 ><%= @article.title %></h1>
      </div>
    </div>
    <div class="landing-blog-hero__img-container">
      <img
        src="<%= @article.header %>"
        class="principal"
        alt="<%= @article.title %>"
        fetchpriority="high"
        width="1400"
        height="600"
        decoding="async"
      />
    </div>
    <div class="landing-blog-hero__info">
      <p>
        <% #=t("blog.landing.published")%>
        <%=t("blog.landing.last_modified")%>
        <time datetime="<%=@article.substantive_change_at[0..9]%>">
          <%=@article.substantive_change_at[0..9]%>
        </time>
        <span class="landing-blog-hero__read-time">
          · <%= t('blog.landing.read_time', minutes: @article.reading_time_minutes) %>
        </span>
      </p>
    </div>
    <% if @article.audio && !@article.audio.to_s.empty? %>
      <div class="landing-blog-hero__audio">
        <p class="landing-blog-hero__audio-label"><%= t('blog.landing.listen') %></p>
        <!-- metadata, not none: with nothing preloaded the player has no
             duration to show and reads 0:00 until you press play. This is a
             few KB of header, not the audio. -->
        <audio controls preload="metadata" src="<%= @article.audio %>">
          <%= t('blog.landing.listen') %>
        </audio>
      </div>
    <% end %>
</section>
