<%#
  Light-mode contact form for Kleer Lab.
  locals: action (string), values (hash of name/email/company/message), errors (hash)
%>
<% values ||= {}; errors ||= {} %>
<form action="<%= action %>" method="post" novalidate
      style="padding: 1.5rem 2rem 2rem; display: flex; flex-direction: column; gap: 1.25rem;">

  <%# Nombre %>
  <div>
    <label style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
                  letter-spacing: 0.2em; color: #374151; margin-bottom: 0.375rem;">
      Nombre <span style="color: #dc2626;">*</span>
    </label>
    <input type="text" name="name" value="<%= values['name'] %>" placeholder="Tu nombre completo"
      style="width: 100%; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.875rem;
             background: #f9fafb; border: 1px solid <%= errors['name'] ? '#dc2626' : '#e5e7eb' %>;
             color: #111827; outline: none; box-sizing: border-box;">
    <% if errors['name'] %>
      <p style="margin-top: 0.25rem; font-size: 0.75rem; color: #dc2626;"><%= errors['name'] %></p>
    <% end %>
  </div>

  <%# Email %>
  <div>
    <label style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
                  letter-spacing: 0.2em; color: #374151; margin-bottom: 0.375rem;">
      Correo electrónico <span style="color: #dc2626;">*</span>
    </label>
    <input type="email" name="email" value="<%= values['email'] %>" placeholder="tu@empresa.com"
      style="width: 100%; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.875rem;
             background: #f9fafb; border: 1px solid <%= errors['email'] ? '#dc2626' : '#e5e7eb' %>;
             color: #111827; outline: none; box-sizing: border-box;">
    <% if errors['email'] %>
      <p style="margin-top: 0.25rem; font-size: 0.75rem; color: #dc2626;"><%= errors['email'] %></p>
    <% end %>
  </div>

  <%# Empresa %>
  <div>
    <label style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
                  letter-spacing: 0.2em; color: #374151; margin-bottom: 0.375rem;">
      Empresa
      <span style="font-weight: 400; text-transform: none; letter-spacing: 0; color: #9ca3af;">(opcional)</span>
    </label>
    <input type="text" name="company" value="<%= values['company'] %>" placeholder="Tu empresa o emprendimiento"
      style="width: 100%; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.875rem;
             background: #f9fafb; border: 1px solid #e5e7eb;
             color: #111827; outline: none; box-sizing: border-box;">
  </div>

  <%# Mensaje %>
  <div>
    <label style="display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
                  letter-spacing: 0.2em; color: #374151; margin-bottom: 0.375rem;">
      Mensaje <span style="color: #dc2626;">*</span>
    </label>
    <textarea name="message" rows="4" placeholder="Cuéntanos cómo funciona hoy, quiénes participan, cuánto tiempo consume y qué suele salir mal. No necesitas saber qué tecnología usar."
      style="width: 100%; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.875rem;
             background: #f9fafb; border: 1px solid <%= errors['message'] ? '#dc2626' : '#e5e7eb' %>;
             color: #111827; outline: none; resize: none; box-sizing: border-box;"><%= values['message'] %></textarea>
    <% if errors['message'] %>
      <p style="margin-top: 0.25rem; font-size: 0.75rem; color: #dc2626;"><%= errors['message'] %></p>
    <% end %>
  </div>

  <%# reCAPTCHA %>
  <div>
    <%= recaptcha_tags %>
    <% if errors['recaptcha'] %>
      <p style="margin-top: 0.5rem; font-size: 0.75rem; color: #dc2626;"><%= errors['recaptcha'] %></p>
    <% end %>
  </div>

  <%# Submit + fallback %>
  <div>
    <button type="submit" class="btn btn-primary w-full" style="cursor: pointer; font-size: 1rem; padding: 0.75rem 1rem;">
      Enviar mensaje
    </button>
    <p style="margin-top: 1rem; text-align: center; font-size: 0.75rem; color: #9ca3af;">
      Si el formulario falla, escríbenos a
      <span style="color: #374151; font-weight: 600;"><%= LabViewHelper::LAB_CONTACT_EMAIL %></span>
    </p>
  </div>
</form>
