<%#
  Shared <head> essentials for standalone noindex utility pages
  (participant flow, etc.) that intentionally render without the full
  layout/layout2022 chrome. Pass a `page_title` local.
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= page_title %></title>
<meta name="robots" content="noindex, nofollow">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
<%= erb :'layout/_google_tracker_head' %>
