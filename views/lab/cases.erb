<section class="px-8 py-24" id="casos">
  <div class="max-w-7xl mx-auto">
    <%= lab_section_header(label: "CASOS", title: "Procesos manuales resueltos con aplicaciones a medida", size: :md) %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <% @cases.each do |c| %>
        <%= erb :'lab/_case_card', layout: false, locals: { c: c } %>
      <% end %>
    </div>
  </div>
</section>
