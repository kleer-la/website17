<%#
  Light-mode contact form for Kleer Lab.
  locals: action (string), values (hash of name/email/company/message), errors (hash)

  Fields carry `lab-field` purely so application.css can give them a focus ring:
  the rest of the styling is inline (this form renders on a light panel over a
  dark page) and an inline style cannot express :focus.

  `id_prefix` keeps ids unique: /contacto renders this inline, every other page
  renders it inside the modal, and duplicate ids would break label association.
%>
<% values ||= {}; errors ||= {} %>
<% id_prefix ||= 'lab-contact' %>
<%
  label_style = 'display: block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;' \
                'letter-spacing: 0.2em; color: #374151; margin-bottom: 0.375rem;'
  field_style = lambda do |invalid|
    'width: 100%; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.875rem;' \
    "background: #f9fafb; border: 1px solid #{invalid ? '#dc2626' : '#e5e7eb'};" \
    'color: #111827; box-sizing: border-box;'
  end
  error_style = 'margin-top: 0.25rem; font-size: 0.75rem; color: #b91c1c;'
%>
<form action="<%= action %>" method="post" novalidate
      style="padding: 1.5rem 2rem 2rem; display: flex; flex-direction: column; gap: 1.25rem;">

  <%# Nombre %>
  <div>
    <label for="<%= id_prefix %>-name" style="<%= label_style %>">
      Nombre <span aria-hidden="true" style="color: #b91c1c;">*</span>
    </label>
    <input type="text" class="lab-field" id="<%= id_prefix %>-name" name="name"
      value="<%= values['name'] %>" placeholder="Tu nombre completo" required aria-required="true"
      <% if errors['name'] %>aria-invalid="true" aria-describedby="<%= id_prefix %>-name-error"<% end %>
      style="<%= field_style.call(errors['name']) %>">
    <% if errors['name'] %>
      <p id="<%= id_prefix %>-name-error" style="<%= error_style %>"><%= errors['name'] %></p>
    <% end %>
  </div>

  <%# Email %>
  <div>
    <label for="<%= id_prefix %>-email" style="<%= label_style %>">
      Correo electrónico <span aria-hidden="true" style="color: #b91c1c;">*</span>
    </label>
    <input type="email" class="lab-field" id="<%= id_prefix %>-email" name="email"
      value="<%= values['email'] %>" placeholder="tu@empresa.com" required aria-required="true"
      <% if errors['email'] %>aria-invalid="true" aria-describedby="<%= id_prefix %>-email-error"<% end %>
      style="<%= field_style.call(errors['email']) %>">
    <% if errors['email'] %>
      <p id="<%= id_prefix %>-email-error" style="<%= error_style %>"><%= errors['email'] %></p>
    <% end %>
  </div>

  <%# Empresa %>
  <div>
    <label for="<%= id_prefix %>-company" style="<%= label_style %>">
      Empresa
      <span style="font-weight: 400; text-transform: none; letter-spacing: 0; color: #6b7280;">(opcional)</span>
    </label>
    <input type="text" class="lab-field" id="<%= id_prefix %>-company" name="company"
      value="<%= values['company'] %>" placeholder="Tu empresa o emprendimiento"
      style="<%= field_style.call(false) %>">
  </div>

  <%# Mensaje %>
  <div>
    <label for="<%= id_prefix %>-message" style="<%= label_style %>">
      Mensaje <span aria-hidden="true" style="color: #b91c1c;">*</span>
    </label>
    <textarea class="lab-field" id="<%= id_prefix %>-message" name="message" rows="4" required aria-required="true"
      placeholder="Cuéntanos cómo funciona hoy, quiénes participan, cuánto tiempo consume y qué suele salir mal. No necesitas saber qué tecnología usar."
      <% if errors['message'] %>aria-invalid="true" aria-describedby="<%= id_prefix %>-message-error"<% end %>
      style="<%= field_style.call(errors['message']) %> resize: none;"><%= values['message'] %></textarea>
    <% if errors['message'] %>
      <p id="<%= id_prefix %>-message-error" style="<%= error_style %>"><%= errors['message'] %></p>
    <% end %>
  </div>

  <%# reCAPTCHA %>
  <div>
    <%= recaptcha_tags %>
    <% if errors['recaptcha'] %>
      <p style="<%= error_style %> margin-top: 0.5rem;"><%= errors['recaptcha'] %></p>
    <% end %>
  </div>

  <%# Submit + fallback %>
  <div>
    <button type="submit" class="btn btn-primary w-full" style="cursor: pointer; font-size: 1rem; padding: 0.75rem 1rem;">
      Enviar mensaje
    </button>
    <p style="margin-top: 1rem; text-align: center; font-size: 0.75rem; color: #6b7280;">
      Si el formulario falla, escríbenos a
      <span style="color: #374151; font-weight: 600;"><%= LabViewHelper::LAB_CONTACT_EMAIL %></span>
    </p>
  </div>
</form>
