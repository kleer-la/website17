<%
services_data = section_data(@page, 'services', {
  title: 'Explora Nuestros Servicios',
  content: 'Queremos conocer tus desafíos para ofrecerte una solución personalizada.'
})
title = services_data[:title]
description = services_data[:content]
%>
<% titles = to_lines(title) %>
<section id="homepage-service-areas" class="container mt-5 mb-5 service-areas">
  <div class="mb-4">
    <h2>
      <span class="highlight highlight--first"><%= titles[0] %> </span>
      <span class="highlight"><%= titles[1] %> </span>
      <span class="highlight"><%= titles[2] %></span>
    </h2>
    <p><%= description%></p>
  </div>

  <% if @featured_program_first %>
    <div class="mb-4">
      <%= erb :'home/_featured_program', locals: { heading_level: 'h3' } %>
    </div>
  <% end %>

  <div class="row justify-content-center align-items-stretch">
    <% @areas.each do |area| %>
      <%= erb :'home/_service_area_card', locals: { area: area } %>
    <% end %>
  </div>
</section>