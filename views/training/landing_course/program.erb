<%
  program_html = @markdown_renderer.render(@event_type.program.to_s)
  separated_program = h4_blocks(program_html).map { |item, subitem| { item: item, subitem: subitem } }
  middle_space = (separated_program.length + 1) / 2
  # A step named like a term the course FAQ defines ("¿Qué es Kanban…?") links to that question.
  definitions = course_faq_definitions
%>
<link rel="stylesheet" href="<%= css_url('service-content.css') %>">
<% unless separated_program.empty? %>
<section id="course-program">
  <div class="container mt-5">
    <h2 class="mb-5 text-center common-subtitle"><%= t("course_landing.program") %></h2>
    <p></p>
    <div class="course-program__container row mb-5">
      <div class="col-md-6">
      <% separated_program.each.with_index do  |item, index| %>
        <% if index >= middle_space
             break
           end
        %>
        <%= erb :'training/landing_course/_program-item', locals: {item: item[:item], subitem: item[:subitem], index: index, definition: faq_definition_for(item[:item], definitions)} %>
      <% end %>
      </div>
      <div class="col-md-6">
        <% separated_program.each.with_index do |item, index| %>
          <%
            if index < middle_space
              next
            end
          %>
          <%= erb :'training/landing_course/_program-item', locals: {item: item[:item], subitem: item[:subitem], index: index, definition: faq_definition_for(item[:item], definitions)} %>
        <% end %>
      </div>
    </div>
  </div>
  <% if @event_type.brochure and @event_type.brochure != "" %>
    <div class="button-container mt-5 mb-5 d-flex justify-content-center">
      <a class="my-primary-button" href="<%=@event_type.brochure %>">
        Descargar programa
      </a>
    </div>
  <% end %>

</section>
<% end %>
