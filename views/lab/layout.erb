<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= lab_title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kleer Lab">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= lab_description %>">
    <link rel="canonical" href="<%= lab_canonical_url %>">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= lab_title %>">
    <meta property="og:description" content="<%= lab_description %>">
    <meta property="og:image" content="<%= lab_og_image %>">
    <meta property="og:image:width" content="2833">
    <meta property="og:image:height" content="1600">
    <meta property="og:image:type" content="image/png">
    <meta property="og:type" content="<%= lab_og_type %>">
    <meta property="og:url" content="<%= lab_canonical_url %>">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= lab_title %>">
    <meta name="twitter:description" content="<%= lab_description %>">
    <meta name="twitter:image" content="<%= lab_og_image %>">

    <%= lab_render_json_ld(lab_json_ld_organization) %>
    <%= @lab_head_extra %>

    <link rel="icon" href="/lab/icon.png" type="image/png">
    <link rel="icon" href="/lab/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/lab/icon.png">

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/lab/application.css">
    <script src="/lab/lab.js" defer></script>
  </head>

  <body class="min-h-screen bg-background text-on-background" style="font-family: var(--font-body);">
    <%= erb :'lab/_navbar', layout: false %>
    <main class="relative pt-20">
      <%= yield %>
    </main>
    <%= erb :'lab/_footer', layout: false %>
    <%= erb :'lab/_contact_modal', layout: false %>
  </body>
</html>
